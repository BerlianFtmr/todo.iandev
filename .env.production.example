# ============================================================
# Environment - PRODUCTION TEMPLATE (todo.iandev)
# Copy ke .env.production lalu isi nilai sebenarnya:
#   cp .env.production.example .env.production
# ============================================================

# --- MySQL (service internal docker) ---
MYSQL_ROOT_PASSWORD=isi_password_root_kuat
DB_USER=myuser
DB_PASSWORD=isi_password_db_kuat
DB_NAME=tododb

# --- Aplikasi ---
DB_HOST=mysql
DB_PORT=3306
APP_TIMEZONE=+07:00
PORT=5000

# Port host yang di-bind (localhost only, diakses Cloudflare Tunnel)
APP_HOST_PORT=127.0.0.1:5000
