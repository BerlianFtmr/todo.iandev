<!DOCTYPE html>
<html lang="id" data-theme="sky">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>todo.iandev - Todo List & Progress Tracker SPA</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome v6 CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            lavender: {
              50: 'rgb(var(--c-50) / <alpha-value>)',
              100: 'rgb(var(--c-100) / <alpha-value>)',
              200: 'rgb(var(--c-200) / <alpha-value>)',
              300: 'rgb(var(--c-300) / <alpha-value>)',
              400: 'rgb(var(--c-400) / <alpha-value>)',
              500: 'rgb(var(--c-500) / <alpha-value>)',
              600: 'rgb(var(--c-600) / <alpha-value>)',
              700: 'rgb(var(--c-700) / <alpha-value>)',
              800: 'rgb(var(--c-800) / <alpha-value>)',
              900: 'rgb(var(--c-900) / <alpha-value>)',
              950: 'rgb(var(--c-950) / <alpha-value>)',
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Default Theme: Blue Sky */
    :root, [data-theme="sky"] {
      --c-50: 240 249 255;
      --c-100: 224 242 254;
      --c-200: 186 230 253;
      --c-300: 125 211 252;
      --c-400: 56 189 248;
      --c-500: 14 165 233;
      --c-600: 2 132 199;
      --c-700: 3 105 161;
      --c-800: 7 89 133;
      --c-900: 12 74 110;
      --c-950: 8 47 73;
    }

    /* Lavender Theme */
    [data-theme="lavender"] {
      --c-50: 248 245 255;
      --c-100: 240 232 255;
      --c-200: 225 212 254;
      --c-300: 203 175 253;
      --c-400: 176 126 251;
      --c-500: 149 75 248;
      --c-600: 129 40 237;
      --c-700: 111 25 212;
      --c-800: 92 23 173;
      --c-900: 76 21 139;
      --c-950: 48 8 98;
    }

    /* Emerald Breeze Theme */
    [data-theme="emerald"] {
      --c-50: 236 253 245;
      --c-100: 209 250 229;
      --c-200: 167 243 208;
      --c-300: 110 231 183;
      --c-400: 52 211 153;
      --c-500: 16 185 129;
      --c-600: 5 150 105;
      --c-700: 4 120 87;
      --c-800: 6 95 70;
      --c-900: 6 78 59;
      --c-950: 2 44 34;
    }

    /* Rose Sunset Theme */
    [data-theme="rose"] {
      --c-50: 255 241 242;
      --c-100: 255 228 230;
      --c-200: 254 205 211;
      --c-300: 253 164 175;
      --c-400: 251 113 133;
      --c-500: 244 63 94;
      --c-600: 225 29 72;
      --c-700: 190 18 60;
      --c-800: 159 18 57;
      --c-900: 136 19 55;
      --c-950: 76 5 25;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: rgb(var(--c-50));
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgb(var(--c-100));
    }
    ::-webkit-scrollbar-thumb {
      background: rgb(var(--c-300));
      border-radius: 4px;
    }
  </style>
</head>
<body class="text-slate-700 min-h-screen flex flex-col antialiased">

  <div id="app" class="min-h-screen flex flex-col">

    <!-- ========================================== -->
    <!-- VIEW 1: LOGIN & REGISTER PAGE              -->
    <!-- ========================================== -->
    <div id="loginView" class="relative min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-lavender-100 via-white to-lavender-50">
      
      <!-- Theme Switcher Top Right -->
      <div class="absolute top-4 right-4 flex items-center gap-1.5 bg-white/80 backdrop-blur-md p-1.5 rounded-2xl border border-lavender-100 shadow-sm">
        <span class="text-xs font-semibold text-slate-500 px-2 flex items-center gap-1">
          <i class="fa-solid fa-palette text-lavender-600"></i> Tema:
        </span>
        <button onclick="switchTheme('sky')" title="Blue Sky" class="w-7 h-7 rounded-full bg-[#0284c7] border-2 border-white shadow hover:scale-110 transition"></button>
        <button onclick="switchTheme('lavender')" title="Lavender Mist" class="w-7 h-7 rounded-full bg-[#8128ed] border-2 border-white shadow hover:scale-110 transition"></button>
        <button onclick="switchTheme('emerald')" title="Emerald Breeze" class="w-7 h-7 rounded-full bg-[#059669] border-2 border-white shadow hover:scale-110 transition"></button>
        <button onclick="switchTheme('rose')" title="Rose Sunset" class="w-7 h-7 rounded-full bg-[#e11d48] border-2 border-white shadow hover:scale-110 transition"></button>
      </div>

      <div class="w-full max-w-md bg-white rounded-2xl shadow-xl shadow-lavender-200/50 border border-lavender-100 p-8">
        <div class="text-center mb-6">
          <div class="w-16 h-16 bg-lavender-100 text-lavender-600 rounded-2xl flex items-center justify-center mx-auto mb-3 text-2xl shadow-inner">
            <i class="fa-solid fa-list-check"></i>
          </div>
          <h1 class="text-2xl font-bold text-slate-800">todo.iandev</h1>
          <p class="text-sm text-slate-500 mt-1">Kelola tugas dan catat progress harianmu</p>
        </div>

        <!-- Tab Toggle Login vs Register -->
        <div class="flex bg-slate-100 p-1 rounded-xl mb-6 border border-slate-200/60">
          <button id="tabLogin" onclick="switchAuthTab('login')" class="w-1/2 py-2 text-xs font-bold rounded-lg bg-lavender-600 text-white shadow transition">
            Masuk
          </button>
          <button id="tabRegister" onclick="switchAuthTab('register')" class="w-1/2 py-2 text-xs font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition">
            Daftar Akun
          </button>
        </div>

        <!-- FORM LOGIN -->
        <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
          <div id="loginAlert" class="hidden p-3 rounded-xl text-xs font-semibold bg-rose-50 text-rose-600 border border-rose-200"></div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              <i class="fa-regular fa-envelope mr-1 text-lavender-500"></i> Email
            </label>
            <input 
              type="email" 
              id="loginEmail" 
              required 
              placeholder="nama@email.com"
              class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-lavender-400 transition"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              <i class="fa-solid fa-lock mr-1 text-lavender-500"></i> Kata Sandi
            </label>
            <input 
              type="password" 
              id="loginPassword" 
              required 
              placeholder="Masukkan kata sandi"
              class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-lavender-400 transition"
            />
          </div>

          <button 
            type="submit" 
            class="w-full bg-lavender-600 hover:bg-lavender-700 text-white font-semibold py-3 px-4 rounded-xl shadow-lg shadow-lavender-500/25 transition transform active:scale-[0.98] flex items-center justify-center gap-2 text-sm mt-2"
          >
            <span>Masuk ke Dashboard</span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </button>
        </form>

        <!-- FORM REGISTER -->
        <form id="registerForm" onsubmit="handleRegister(event)" class="space-y-4 hidden">
          <div id="registerAlert" class="hidden p-3 rounded-xl text-xs font-semibold bg-rose-50 text-rose-600 border border-rose-200"></div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              <i class="fa-regular fa-user mr-1 text-lavender-500"></i> Nama Lengkap
            </label>
            <input 
              type="text" 
              id="regName" 
              required 
              placeholder="Contoh: Budi Santoso"
              class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-lavender-400 transition"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              <i class="fa-regular fa-envelope mr-1 text-lavender-500"></i> Email
            </label>
            <input 
              type="email" 
              id="regEmail" 
              required 
              placeholder="nama@email.com"
              class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-lavender-400 transition"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              <i class="fa-solid fa-lock mr-1 text-lavender-500"></i> Kata Sandi
            </label>
            <input 
              type="password" 
              id="regPassword" 
              required 
              placeholder="Minimal 6 karakter"
              class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-lavender-400 transition"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              <i class="fa-solid fa-shield-halved mr-1 text-lavender-500"></i> Konfirmasi Kata Sandi
            </label>
            <input 
              type="password" 
              id="regConfirmPassword" 
              required 
              placeholder="Ulangi kata sandi"
              class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-lavender-400 transition"
            />
          </div>

          <button 
            type="submit" 
            class="w-full bg-lavender-600 hover:bg-lavender-700 text-white font-semibold py-3 px-4 rounded-xl shadow-lg shadow-lavender-500/25 transition transform active:scale-[0.98] flex items-center justify-center gap-2 text-sm mt-2"
          >
            <span>Daftar Akun Baru</span>
            <i class="fa-solid fa-user-plus text-xs"></i>
          </button>
        </form>

      </div>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 2: DASHBOARD PAGE                     -->
    <!-- ========================================== -->
    <div id="dashboardView" class="hidden min-h-screen flex flex-col md:flex-row bg-slate-50">

      <!-- SIDEBAR -->
      <aside class="w-full md:w-72 bg-white border-r border-lavender-100 flex flex-col shrink-0">
        <div class="p-5 border-b border-lavender-100 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-lavender-100 text-lavender-600 rounded-xl flex items-center justify-center text-lg font-bold shadow-sm">
              <i class="fa-solid fa-list-check"></i>
            </div>
            <div>
              <h2 class="font-bold text-slate-800 text-base leading-tight">todo.iandev</h2>
              <span id="activeThemeBadge" class="text-xs text-lavender-600 font-medium bg-lavender-50 px-2 py-0.5 rounded-full border border-lavender-100 inline-flex items-center gap-1">
                <i class="fa-solid fa-cloud-sun"></i> Blue Sky Theme
              </span>
            </div>
          </div>
        </div>

        <div class="p-4 flex-1 overflow-y-auto space-y-6">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2 px-3">Menu Utama</div>
            <nav class="space-y-1">
              <button 
                onclick="selectFolder('all')" 
                id="folder-nav-all"
                class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition bg-lavender-100 text-lavender-900 font-semibold"
              >
                <div class="flex items-center gap-3">
                  <i class="fa-solid fa-layer-group text-lavender-600 w-5"></i>
                  <span>Semua Task</span>
                </div>
                <span id="badge-all-count" class="bg-white text-lavender-700 text-xs px-2 py-0.5 rounded-full font-bold shadow-sm">0</span>
              </button>
            </nav>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2 px-3">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Folder Saya</span>
              <button onclick="openAddFolderModal()" class="text-xs text-lavender-600 hover:text-lavender-800 hover:bg-lavender-50 p-1.5 rounded-lg transition">
                <i class="fa-solid fa-plus mr-1"></i> Tambah
              </button>
            </div>
            <nav id="folderListContainer" class="space-y-1"></nav>
          </div>
        </div>

        <div class="p-4 border-t border-lavender-100 bg-lavender-50/50 flex items-center justify-between">
          <div class="flex items-center gap-3 truncate">
            <div class="w-9 h-9 bg-lavender-600 text-white rounded-full flex items-center justify-center font-bold text-sm shadow">
              <i class="fa-solid fa-user"></i>
            </div>
            <div class="truncate">
              <p class="text-xs font-bold text-slate-800 truncate" id="userDisplayName">-</p>
              <p class="text-[11px] text-slate-500 truncate" id="userDisplayEmail">-</p>
            </div>
          </div>
          <button onclick="handleLogout()" class="text-slate-400 hover:text-rose-600 p-2 rounded-lg hover:bg-rose-50 transition" title="Keluar">
            <i class="fa-solid fa-right-from-bracket"></i>
          </button>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <header class="bg-white border-b border-lavender-100 px-6 py-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2" id="currentFolderTitle">
              <i class="fa-solid fa-layer-group text-lavender-600"></i>
              <span>Semua Task</span>
            </h1>
            <p class="text-xs text-slate-500 mt-0.5" id="currentFolderDesc">Menampilkan semua tugas dari seluruh folder</p>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-1.5 bg-slate-50 p-1.5 rounded-xl border border-slate-200">
              <span class="text-xs font-semibold text-slate-500 px-1 hidden sm:inline-flex items-center gap-1">
                <i class="fa-solid fa-palette text-lavender-600"></i> Tema:
              </span>
              <button onclick="switchTheme('sky')" class="theme-btn-sky px-2.5 py-1 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 bg-white border border-slate-200 text-slate-700 shadow-sm">
                <span class="w-3 h-3 rounded-full bg-[#0284c7]"></span>
                <span class="hidden sm:inline">Blue Sky</span>
              </button>
              <button onclick="switchTheme('lavender')" class="theme-btn-lavender px-2.5 py-1 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:bg-slate-100">
                <span class="w-3 h-3 rounded-full bg-[#8128ed]"></span>
                <span class="hidden sm:inline">Lavender</span>
              </button>
              <button onclick="switchTheme('emerald')" class="theme-btn-emerald px-2.5 py-1 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:bg-slate-100">
                <span class="w-3 h-3 rounded-full bg-[#059669]"></span>
                <span class="hidden sm:inline">Emerald</span>
              </button>
              <button onclick="switchTheme('rose')" class="theme-btn-rose px-2.5 py-1 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:bg-slate-100">
                <span class="w-3 h-3 rounded-full bg-[#e11d48]"></span>
                <span class="hidden sm:inline">Rose</span>
              </button>
            </div>

            <button onclick="openAddTodoModal()" class="bg-lavender-600 hover:bg-lavender-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-md shadow-lavender-500/20 transition flex items-center gap-2 active:scale-95">
              <i class="fa-solid fa-circle-plus"></i>
              <span>Task Baru</span>
            </button>
          </div>
        </header>

        <div class="flex-1 overflow-y-auto p-6 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <div class="flex gap-2">
              <button onclick="setFilter('all')" id="filter-all" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-lavender-600 text-white shadow-sm flex items-center gap-1.5">Semua</button>
              <button onclick="setFilter('pending')" id="filter-pending" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-lavender-100 transition flex items-center gap-1.5">Sedang Jalan</button>
              <button onclick="setFilter('completed')" id="filter-completed" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-lavender-100 transition flex items-center gap-1.5">Selesai</button>
            </div>
            <span class="text-xs text-slate-400" id="todoCountLabel">0 Task</span>
          </div>

          <div id="todoGrid" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4"></div>
        </div>
      </main>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 3: FULL SCREEN DETAIL TASK PAGE (SPA) -->
    <!-- ========================================== -->
    <div id="detailScreenView" class="hidden min-h-screen flex flex-col bg-slate-50">
      
      <!-- Top Navigation Header -->
      <header class="bg-white border-b border-lavender-100 px-6 py-4 flex items-center justify-between">
        <button 
          onclick="backToDashboard()" 
          class="text-xs font-semibold text-slate-700 hover:text-lavender-700 bg-slate-100 hover:bg-lavender-100 px-4 py-2 rounded-xl transition flex items-center gap-2"
        >
          <i class="fa-solid fa-arrow-left"></i>
          <span>Kembali ke Dashboard</span>
        </button>

        <div class="flex items-center gap-2">
          <span id="screenDetailFolderBadge" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-lavender-50 text-lavender-700 border border-lavender-200 flex items-center gap-1.5 shadow-sm"></span>
          <span id="screenDetailStatusBadge" class="text-xs font-semibold px-3 py-1.5 rounded-lg flex items-center gap-1.5"></span>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="flex-1 max-w-6xl w-full mx-auto p-6 space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
          
          <!-- LEFT COLUMN: Task Info -->
          <div class="bg-white rounded-2xl border border-lavender-100 p-6 shadow-sm space-y-5 lg:col-span-1">
            <div class="flex items-start gap-3.5">
              <div class="w-12 h-12 rounded-2xl bg-lavender-100 text-lavender-600 flex items-center justify-center text-2xl shrink-0 shadow-inner">
                <i id="screenDetailIcon" class="fa-solid fa-list-check"></i>
              </div>
              <div>
                <h1 id="screenDetailTitle" class="text-xl font-bold text-slate-800 leading-snug"></h1>
                <p class="text-xs text-slate-400 mt-1 flex items-center gap-1.5">
                  <i class="fa-regular fa-clock"></i> Dibuat: <span id="screenDetailDate"></span>
                </p>
              </div>
            </div>

            <hr class="border-slate-100">

            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
                <i class="fa-solid fa-align-left text-lavender-500"></i> Deskripsi Task
              </h4>
              <p id="screenDetailDesc" class="text-xs md:text-sm text-slate-700 bg-slate-50 border border-slate-200/80 rounded-xl p-4 leading-relaxed whitespace-pre-line"></p>
            </div>

            <div class="space-y-2 pt-2">
              <button id="screenDetailToggleBtn" class="w-full py-2.5 text-xs font-semibold rounded-xl transition flex items-center justify-center gap-2 active:scale-95 shadow-sm"></button>

              <div class="grid grid-cols-2 gap-2">
                <button id="screenDetailEditBtn" class="py-2 text-xs font-semibold bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 rounded-xl transition flex items-center justify-center gap-1.5 shadow-sm">
                  <i class="fa-solid fa-pen-to-square text-lavender-600"></i> Edit Task
                </button>
                <button id="screenDetailDeleteBtn" class="py-2 text-xs font-semibold bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-xl transition flex items-center justify-center gap-1.5">
                  <i class="fa-solid fa-trash"></i> Hapus Task
                </button>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Timeline Progress Commit -->
          <div class="bg-white rounded-2xl border border-lavender-100 p-6 shadow-sm space-y-5 lg:col-span-2">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                <i class="fa-solid fa-code-commit text-lavender-600"></i>
                <span>Progress Commit Tracker</span>
              </h3>
              <span id="screenDetailLogCountBadge" class="text-xs bg-lavender-50 text-lavender-700 border border-lavender-200 px-3 py-1 rounded-full font-semibold">
                0 Catatan Progress
              </span>
            </div>

            <div class="bg-lavender-50/70 border border-lavender-100 rounded-2xl p-4 space-y-3">
              <label class="block text-xs font-bold text-slate-700 flex items-center gap-1.5">
                <i class="fa-solid fa-plus-circle text-lavender-600"></i>
                <span>Tambah Catatan Progress / Update Baru</span>
              </label>
              <textarea 
                id="screenDetailCommitMsgInput" 
                rows="3" 
                placeholder="Tuliskan detail progress yang baru diselesaikan..." 
                class="w-full px-4 py-3 bg-white border border-lavender-200 rounded-xl text-xs md:text-sm focus:outline-none focus:ring-2 focus:ring-lavender-400"
              ></textarea>
              <div class="flex justify-end">
                <button 
                  onclick="handleAddScreenCommitLog()" 
                  class="bg-lavender-600 hover:bg-lavender-700 text-white text-xs font-semibold px-5 py-2.5 rounded-xl shadow-md shadow-lavender-500/20 flex items-center gap-2 transition active:scale-95"
                >
                  <i class="fa-solid fa-check"></i>
                  <span>Simpan Progress Commit</span>
                </button>
              </div>
            </div>

            <div class="pt-2">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">
                Histori Catatan Progress
              </h4>
              <div id="screenDetailTimelineContainer"></div>
            </div>
          </div>

        </div>
      </main>
    </div>

  </div>

  <!-- MODAL: TAMBAH / EDIT FOLDER -->
  <div id="folderModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl border border-lavender-100 overflow-hidden">
      <div class="bg-lavender-50 px-6 py-4 border-b border-lavender-100 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 flex items-center gap-2" id="folderModalTitle">
          <i class="fa-solid fa-folder-plus text-lavender-600"></i> Tambah Folder Baru
        </h3>
        <button onclick="closeFolderModal()" class="text-slate-400 hover:text-slate-600">
