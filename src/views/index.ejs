        <div class="pt-3 flex justify-end gap-2">
          <button type="button" onclick="closeFolderModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition">Batal</button>
          <button type="submit" class="px-5 py-2 text-xs font-semibold bg-lavender-600 hover:bg-lavender-700 text-white rounded-xl shadow transition">Simpan Folder</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: TAMBAH / EDIT TODO -->
  <div id="todoModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg shadow-2xl border border-lavender-100 overflow-hidden">
      <div class="bg-lavender-50 px-6 py-4 border-b border-lavender-100 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 flex items-center gap-2" id="todoModalTitle">
          <i class="fa-solid fa-square-plus text-lavender-600"></i> Buat Task Baru
        </h3>
        <button onclick="closeTodoModal()" class="text-slate-400 hover:text-slate-600">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <form onsubmit="handleSaveTodo(event)" class="p-6 space-y-4">
        <input type="hidden" id="todoEditId">

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">Judul Task / Todo</label>
          <input type="text" id="todoTitleInput" required placeholder="Contoh: Selesaikan Tugas Makalah Bab 1" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-lavender-400 text-sm"/>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">Kategori / Folder</label>
          <select id="todoFolderSelect" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-lavender-400 text-sm"></select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">Ikon Task</label>
          <div class="grid grid-cols-8 gap-2" id="todoIconPickerContainer"></div>
          <input type="hidden" id="selectedTodoIcon" value="fa-list-check">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">Deskripsi Singkat</label>
          <textarea id="todoDescInput" rows="3" placeholder="Tambahkan detail ringkas mengenai tugas ini..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-lavender-400 text-sm"></textarea>
        </div>

        <div class="pt-3 flex justify-end gap-2">
          <button type="button" onclick="closeTodoModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition">Batal</button>
          <button type="submit" class="px-5 py-2 text-xs font-semibold bg-lavender-600 hover:bg-lavender-700 text-white rounded-xl shadow transition">Simpan Task</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    <%- include('partials/dateUtils') %>
    // GLOBAL STATE MANAGEMENT
    const THEMES = {
      sky: { name: 'Blue Sky', badge: 'Blue Sky Theme', icon: 'fa-cloud-sun' },
      lavender: { name: 'Lavender Mist', badge: 'Lavender Theme', icon: 'fa-droplet' },
      emerald: { name: 'Emerald Breeze', badge: 'Emerald Theme', icon: 'fa-leaf' },
      rose: { name: 'Rose Sunset', badge: 'Rose Theme', icon: 'fa-heart' }
    };

    let state = {
      currentTheme: 'sky',
      currentUser: null,
      selectedFolderId: 'all',
      currentFilter: 'all',
      activeTodoId: null,

      users: [],
      folders: [],
      todos: [],
      commitLogs: []
    };

    const ICON_LIST = ['fa-folder', 'fa-graduation-cap', 'fa-code', 'fa-book', 'fa-dumbbell', 'fa-briefcase', 'fa-heart', 'fa-layer-group', 'fa-laptop-code', 'fa-pen-nib', 'fa-list-check', 'fa-star'];
    const TASK_ICON_LIST = ['fa-list-check', 'fa-book', 'fa-code', 'fa-laptop-code', 'fa-pen-nib', 'fa-graduation-cap', 'fa-fire', 'fa-rocket', 'fa-lightbulb', 'fa-dumbbell', 'fa-star', 'fa-flag', 'fa-bell', 'fa-calendar-check', 'fa-bullseye', 'fa-heart'];

    const DEFAULT_FOLDERS = [
      { id: 101, name: 'Kuliah & Tugas', icon: 'fa-graduation-cap' },
      { id: 102, name: 'Proyek FocusDo', icon: 'fa-code' },
      { id: 103, name: 'Pribadi & Hobi', icon: 'fa-user' }
    ];

    const DEFAULT_TODOS = [
      { id: 1, folderId: 102, title: 'Integrasi API Database MySQL', desc: 'Menghubungkan frontend SPA dengan REST API Express backend.', icon: 'fa-database', status: 'completed', createdAt: '2026-09-10 10:00' },
      { id: 2, folderId: 102, title: 'Perbaiki URL Fetch di Sandbox Preview', desc: 'Menambahkan safeFetch helper untuk mencegah error URL parse di environment blob/sandbox.', icon: 'fa-bug', status: 'completed', createdAt: '2026-09-10 11:30' },
      { id: 3, folderId: 101, title: 'Makalah Pemrograman Web', desc: 'Menyusun laporan bab 1 - 3 dan lampiran antarmuka pengguna.', icon: 'fa-book', status: 'pending', createdAt: '2026-09-10 14:15' }
    ];

    const DEFAULT_LOGS = [
      { id: 1, todoId: 2, message: 'Menambahkan safeFetch wrapper agar URL fetch aman pada origin blob/sandbox.', createdAt: '2026-09-10 11:32' },
      { id: 2, todoId: 2, message: 'Menyiapkan sinkronisasi localStorage otomatis ketika offline/preview.', createdAt: '2026-09-10 11:40' }
    ];

    // Base URL backend. Dapat dioverride lewat window.__API_BASE__ bila frontend
    // dipisah dari server Express (mis. Vite dev server di port lain).
    const API_BASE = (() => {
      if (typeof window !== 'undefined' && window.__API_BASE__) {
        return String(window.__API_BASE__).replace(/\/$/, '');
      }
      const origin = window.location.origin;
      if (origin && origin !== 'null' && (origin.startsWith('http://') || origin.startsWith('https://'))) {
        return origin.replace(/\/$/, '');
      }
      // Fallback default saat dibuka dari environment blob/sandbox
      return 'http://localhost:5000';
    })();

    async function safeFetch(endpoint, options = {}) {
      const url = endpoint.startsWith('http://') || endpoint.startsWith('https://')
        ? endpoint
        : API_BASE + '/' + endpoint.replace(/^\//, '');
      try {
        const response = await fetch(url, options);
        return response;
      } catch (err) {
        console.error(`Gagal menghubungi API "${url}". Pastikan backend Express berjalan.`, err);
        return null;
      }
    }

    // Helper untuk menampilkan notifikasi singkat
    function showToast(message, type = 'info') {
      const colors = {
        info: 'bg-slate-800',
        success: 'bg-emerald-600',
        error: 'bg-rose-600'
      };
      const el = document.createElement('div');
      el.className = `fixed bottom-5 right-5 z-[9999] px-4 py-3 rounded-xl text-white text-sm font-medium shadow-lg ${colors[type] || colors.info}`;
      el.innerText = message;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 3000);
    }


    // LOCAL STORAGE PERSISTENCE HELPERS (Isolated per User)
    function saveLocalData() {
      if (!state.currentUser) return;
      try {
        const uId = state.currentUser.id;
        localStorage.setItem(`todo_iandev_folders_${uId}`, JSON.stringify(state.folders));
        localStorage.setItem(`todo_iandev_todos_${uId}`, JSON.stringify(state.todos));
        localStorage.setItem(`todo_iandev_logs_${uId}`, JSON.stringify(state.commitLogs));
      } catch (e) {
        console.warn('Gagal menyimpan data ke localStorage:', e);
      }
    }

    function loadLocalFolders() {
      if (!state.currentUser) { state.folders = []; return; }
      const uId = state.currentUser.id;
      const saved = localStorage.getItem(`todo_iandev_folders_${uId}`);
      if (saved) {
        try { state.folders = JSON.parse(saved); return; } catch(e){}
      }
      state.folders = [];
    }

    function loadLocalTodos() {
      if (!state.currentUser) { state.todos = []; return; }
      const uId = state.currentUser.id;
      const saved = localStorage.getItem(`todo_iandev_todos_${uId}`);
      if (saved) {
        try { state.todos = JSON.parse(saved); return; } catch(e){}
      }
      state.todos = [];
    }

    function loadLocalLogs() {
      if (!state.currentUser) { state.commitLogs = []; return; }
      const uId = state.currentUser.id;
      const saved = localStorage.getItem(`todo_iandev_logs_${uId}`);
      if (saved) {
        try { state.commitLogs = JSON.parse(saved); return; } catch(e){}
      }
      state.commitLogs = [];
    }

    function switchAuthTab(tab) {
      const loginForm = document.getElementById('loginForm');
      const registerForm = document.getElementById('registerForm');
      const tabLogin = document.getElementById('tabLogin');
      const tabRegister = document.getElementById('tabRegister');

      document.getElementById('loginAlert').classList.add('hidden');
      document.getElementById('registerAlert').classList.add('hidden');

      if (tab === 'login') {
        loginForm.classList.remove('hidden');
        registerForm.classList.add('hidden');
        tabLogin.className = "w-1/2 py-2 text-xs font-bold rounded-lg bg-lavender-600 text-white shadow transition";
        tabRegister.className = "w-1/2 py-2 text-xs font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition";
      } else {
        loginForm.classList.add('hidden');
        registerForm.classList.remove('hidden');
        tabRegister.className = "w-1/2 py-2 text-xs font-bold rounded-lg bg-lavender-600 text-white shadow transition";
        tabLogin.className = "w-1/2 py-2 text-xs font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition";
      }
    }

    function showAuthAlert(alertId, message) {
      const el = document.getElementById(alertId);
      if (el) {
        el.innerText = message;
        el.classList.remove('hidden');
      }
    }

    async function handleRegister(e) {
      e.preventDefault();
      const name = document.getElementById('regName').value.trim();
      const email = document.getElementById('regEmail').value.trim();
      const password = document.getElementById('regPassword').value;
      const confirmPassword = document.getElementById('regConfirmPassword').value;

      if (password !== confirmPassword) {
        showAuthAlert('registerAlert', 'Konfirmasi kata sandi tidak cocok!');
        return;
      }

      const response = await safeFetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password })
      });

      if (!response) {
        showAuthAlert('registerAlert', 'Tidak dapat terhubung ke server. Pastikan backend berjalan.');
        return;
      }

      const resData = await response.json().catch(() => ({}));
      if (!response.ok) {
        showAuthAlert('registerAlert', resData.error || 'Pendaftaran gagal. Coba lagi.');
        return;
      }

      document.getElementById('loginEmail').value = email;
      document.getElementById('loginPassword').value = '';
      switchAuthTab('login');
      showAuthAlert('loginAlert', resData.message || 'Pendaftaran berhasil! Silakan masuk.');
    }

    async function handleLogin(e) {
      e.preventDefault();
      const email = document.getElementById('loginEmail').value.trim();
      const password = document.getElementById('loginPassword').value;

      if (!email || !password) {
        showAuthAlert('loginAlert', 'Harap isi email dan kata sandi.');
        return;
      }

      let userObj = null;

      const response = await safeFetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      if (!response) {
        showAuthAlert('loginAlert', 'Tidak dapat terhubung ke server. Pastikan backend berjalan.');
        return;
      }

      const resData = await response.json().catch(() => ({}));
      if (!response.ok) {
        showAuthAlert('loginAlert', resData.error || 'Email atau kata sandi salah.');
        return;
      }

      if (resData?.user) {
        userObj = resData.user;
      }

      if (!userObj) {
        showAuthAlert('loginAlert', 'Respons login tidak valid.');
        return;
      }

      state.currentUser = userObj;
      localStorage.setItem('todo_iandev_active_user', JSON.stringify(userObj));

      enterDashboard();
    }

    function hashCode(str) {
      let hash = 0;
      for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i);
        hash |= 0;
      }
      return hash || 1;
    }

    function enterDashboard() {
      document.getElementById('loginView').classList.add('hidden');
      document.getElementById('dashboardView').classList.remove('hidden');
      document.getElementById('userDisplayName').innerText = state.currentUser.name;
      document.getElementById('userDisplayEmail').innerText = state.currentUser.email;

      fetchFoldersFromDB();
      fetchTodosFromDB();
    }

    function nameFromEmail(email) {
      const prefix = email.split('@')[0];
      return prefix.charAt(0).toUpperCase() + prefix.slice(1);
    }

    function handleLogout() {
      state.currentUser = null;
      localStorage.removeItem('todo_iandev_active_user');
      document.getElementById('dashboardView').classList.add('hidden');
      document.getElementById('detailScreenView').classList.add('hidden');
      document.getElementById('loginView').classList.remove('hidden');
      document.getElementById('loginEmail').value = '';
      document.getElementById('loginPassword').value = '';
    }

    // THEME SWITCHER
    function switchTheme(themeKey) {
      if (!THEMES[themeKey]) return;
      state.currentTheme = themeKey;
      document.documentElement.setAttribute('data-theme', themeKey);
      
      localStorage.setItem('user_theme', themeKey);
      
      const themeInfo = THEMES[themeKey];
      const badgeEl = document.getElementById('activeThemeBadge');
      if (badgeEl) {
        badgeEl.innerHTML = `<i class="fa-solid ${themeInfo.icon}"></i> ${themeInfo.badge}`;
      }

      Object.keys(THEMES).forEach(key => {
        const btns = document.querySelectorAll(`.theme-btn-${key}`);
        btns.forEach(btn => {
          btn.className = (key === themeKey) 
            ? `theme-btn-${key} px-2.5 py-1 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 bg-white border border-slate-200 text-slate-800 shadow-sm`
            : `theme-btn-${key} px-2.5 py-1 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 text-slate-500 hover:bg-slate-100`;
        });
      });
    }

    // API FETCH: FOLDERS
    async function fetchFoldersFromDB() {
      const userId = state.currentUser?.id || 1;
      let loaded = false;

      const res = await safeFetch(`/api/folders?user_id=${userId}`);
      if (res && res.ok) {
        try {
          const result = await res.json();
          let folderData = Array.isArray(result) ? result : (result.success && Array.isArray(result.data) ? result.data : null);
          if (folderData) {
            state.folders = folderData.map(f => ({
              id: f.id,
              name: f.name,
              icon: f.icon || 'fa-folder'
            }));
            loaded = true;
          }
        } catch (err) {
          console.warn('Gagal membaca JSON folder dari server, memakai fallback lokal.');
        }
      }

      if (!loaded) {
        loadLocalFolders();
      }

      renderFolders();
    }

    // API FETCH: TODOS
    async function fetchTodosFromDB() {
      const userId = state.currentUser?.id || 1;
      let loaded = false;

      const res = await safeFetch(`/api/todos?user_id=${userId}`);
      if (res && res.ok) {
        try {
          const result = await res.json();
          let todoData = Array.isArray(result) ? result : (result.success && Array.isArray(result.data) ? result.data : null);
          if (todoData) {
            state.todos = todoData.map(t => {
              return {
                id: t.id,
                folderId: t.folder_id || null,
                title: t.title,
                desc: t.description || '',
                icon: t.icon || 'fa-list-check',
                status: t.status || 'pending',
                createdAt: formatDate(t.created_at)
              };
            });
            loaded = true;
          }
        } catch (err) {
          console.warn('Gagal membaca JSON todos dari server, memakai fallback lokal.');
        }
      }

      if (!loaded) {
        loadLocalTodos();
        loadLocalLogs();
      }

      renderAll();
    }

    // API FETCH: COMMIT LOGS
    async function fetchCommitLogsFromDB(todoId) {
      if (!todoId) return;

      const res = await safeFetch(`/api/todos/${todoId}/logs`);
      if (res && res.ok) {
        try {
          const result = await res.json();
          let logData = Array.isArray(result) ? result : (result.success && Array.isArray(result.data) ? result.data : []);
          
          state.commitLogs = state.commitLogs.filter(l => l.todoId !== todoId);
          logData.forEach(log => {
            state.commitLogs.push({
              id: log.id,
              todoId: log.todo_id || todoId,
              message: log.message || log.description || '',
              createdAt: formatDate(log.created_at)
            });
          });
        } catch (err) {
          console.warn('Gagal membaca JSON commit logs dari server.');
        }
      }

      renderScreenCommitLogs();
    }

    // RENDER FUNCTIONS
    function renderAll() {
      renderFolders();
      renderTodos();
    }

    function selectFolder(id) {
      state.selectedFolderId = id;
      
      const navAllBtn = document.getElementById('folder-nav-all');
      if (id === 'all') {
        navAllBtn.className = "w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition bg-lavender-100 text-lavender-900 font-semibold shadow-sm";
        document.getElementById('currentFolderTitle').innerHTML = `<i class="fa-solid fa-layer-group text-lavender-600"></i> <span>Semua Task</span>`;
        document.getElementById('currentFolderDesc').innerText = 'Menampilkan semua tugas dari seluruh folder';
      } else {
        navAllBtn.className = "w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition text-slate-600 hover:bg-slate-100";
        const selected = state.folders.find(f => f.id === id);
        if (selected) {
          document.getElementById('currentFolderTitle').innerHTML = `<i class="fa-solid ${selected.icon} text-lavender-600"></i> <span>${selected.name}</span>`;
          document.getElementById('currentFolderDesc').innerText = `Menampilkan tugas dalam folder ${selected.name}`;
        }
      }

      renderFolders();
      renderTodos();
    }

    function renderFolders() {
      const container = document.getElementById('folderListContainer');
      container.innerHTML = '';

      state.folders.forEach(folder => {
        const count = state.todos.filter(t => t.folderId === folder.id).length;
        const isActive = state.selectedFolderId === folder.id;

        const btn = document.createElement('div');
        btn.className = `group flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition cursor-pointer ${
          isActive ? 'bg-lavender-100 text-lavender-900 font-semibold shadow-sm' : 'text-slate-600 hover:bg-slate-100'
        }`;
        btn.onclick = () => selectFolder(folder.id);

        btn.innerHTML = `
          <div class="flex items-center gap-3 truncate">
            <i class="fa-solid ${folder.icon} text-lavender-600 w-5"></i>
            <span class="truncate">${folder.name}</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs ${isActive ? 'bg-white text-lavender-700 font-bold' : 'bg-slate-100 text-slate-500'} px-2 py-0.5 rounded-full">
              ${count}
            </span>
            <button onclick="event.stopPropagation(); openEditFolderModal(${folder.id})" class="opacity-0 group-hover:opacity-100 text-slate-400 hover:text-lavender-700 p-1 transition">
              <i class="fa-solid fa-pen-to-square text-xs"></i>
            </button>
            <button onclick="event.stopPropagation(); deleteFolder(${folder.id})" class="opacity-0 group-hover:opacity-100 text-slate-400 hover:text-rose-600 p-1 transition">
              <i class="fa-solid fa-trash text-xs"></i>
            </button>
          </div>
        `;
        container.appendChild(btn);
      });

      document.getElementById('badge-all-count').innerText = state.todos.length;
    }

    function setFilter(filterType) {
      state.currentFilter = filterType;
      
      const filters = ['all', 'pending', 'completed'];
      filters.forEach(f => {
        const el = document.getElementById(`filter-${f}`);
        if (!el) return;
        if (f === filterType) {
          el.className = "px-3 py-1.5 text-xs font-semibold rounded-lg bg-lavender-600 text-white shadow-sm flex items-center gap-1.5";
        } else {
          el.className = "px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-lavender-100 transition flex items-center gap-1.5";
        }
      });

      renderTodos();
    }

    function renderTodos() {
      const grid = document.getElementById('todoGrid');
      grid.innerHTML = '';

      let filtered = state.todos;
      if (state.selectedFolderId !== 'all') {
        filtered = filtered.filter(t => t.folderId === state.selectedFolderId);
      }

      if (state.currentFilter === 'pending') {
        filtered = filtered.filter(t => t.status === 'pending');
      } else if (state.currentFilter === 'completed') {
        filtered = filtered.filter(t => t.status === 'completed');
      }

      document.getElementById('todoCountLabel').innerText = `${filtered.length} Task Ditemukan`;

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-12 text-center bg-white rounded-2xl border border-dashed border-lavender-200 p-8">
            <div class="w-12 h-12 bg-lavender-50 text-lavender-400 rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
              <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <h4 class="font-bold text-slate-700 mb-1">Belum Ada Task</h4>
            <p class="text-xs text-slate-400">Klik tombol "Task Baru" di atas untuk menambahkan tugas.</p>
          </div>
        `;
        return;
      }

      filtered.forEach(todo => {
        const folder = state.folders.find(f => f.id === todo.folderId);
        const folderName = folder ? folder.name : 'Umum';
        const folderIcon = folder ? folder.icon : 'fa-folder';
        const logCount = state.commitLogs.filter(l => l.todoId === todo.id).length;

        const card = document.createElement('div');
        card.className = `bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md transition flex flex-col justify-between cursor-pointer group border-lavender-100 hover:border-lavender-300 ${
          todo.status === 'completed' ? 'bg-emerald-50/20 border-emerald-200' : ''
        }`;

        card.onclick = () => openTodoDetailScreen(todo.id);

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-lavender-50 text-lavender-700 border border-lavender-100 flex items-center gap-1.5">
                <i class="fa-solid ${folderIcon}"></i> ${folderName}
              </span>
              <span class="text-xs font-semibold px-2.5 py-1 rounded-lg ${
                todo.status === 'completed' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-50 text-amber-700 border border-amber-200'
              }">
                ${todo.status === 'completed' ? '<i class="fa-solid fa-circle-check"></i> Selesai' : '<i class="fa-solid fa-spinner fa-spin"></i> Sedang Jalan'}
              </span>
            </div>

            <div class="flex items-start gap-3 mb-2">
              <button 
                onclick="event.stopPropagation(); toggleTodoStatus(${todo.id})"
                class="mt-0.5 shrink-0 w-6 h-6 rounded-lg border-2 flex items-center justify-center transition ${
                  todo.status === 'completed' ? 'bg-emerald-500 border-emerald-500 text-white' : 'border-slate-300 bg-white hover:border-emerald-500'
                }"
              >
                ${todo.status === 'completed' ? '<i class="fa-solid fa-check text-xs"></i>' : ''}
              </button>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-slate-800 text-base flex items-center gap-2 group-hover:text-lavender-700 transition ${todo.status === 'completed' ? 'line-through text-slate-400' : ''}">
                  <i class="fa-solid ${todo.icon || 'fa-list-check'} text-lavender-600 shrink-0 text-sm"></i>
                  <span>${todo.title}</span>
                </h3>
                <p class="text-xs text-slate-500 mt-1 line-clamp-2">${todo.desc || 'Tidak ada deskripsi'}</p>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between mt-3">
            <span class="text-[11px] text-slate-400 font-medium"><i class="fa-regular fa-clock"></i> ${todo.createdAt}</span>
            <div class="flex items-center gap-1.5">
              <span class="text-xs bg-lavender-50 text-lavender-700 border border-lavender-200 font-semibold px-2.5 py-1 rounded-xl flex items-center gap-1">
                <i class="fa-solid fa-code-commit text-lavender-600"></i> ${logCount} Log
              </span>
            </div>
          </div>
        `;

        grid.appendChild(card);
      });
    }

    // TASK DETAIL SCREEN VIEW
    async function openTodoDetailScreen(todoId) {
      state.activeTodoId = todoId;
      const todo = state.todos.find(t => t.id === todoId);
      if (!todo) return;

      document.getElementById('dashboardView').classList.add('hidden');
      document.getElementById('detailScreenView').classList.remove('hidden');

      const folder = state.folders.find(f => f.id === todo.folderId);
      const folderBadge = document.getElementById('screenDetailFolderBadge');
      folderBadge.innerHTML = `<i class="fa-solid ${folder ? folder.icon : 'fa-folder'}"></i> ${folder ? folder.name : 'Umum'}`;

      const statusBadge = document.getElementById('screenDetailStatusBadge');
      if (todo.status === 'completed') {
        statusBadge.className = "text-xs font-semibold px-3 py-1.5 rounded-lg bg-emerald-100 text-emerald-800 flex items-center gap-1.5";
        statusBadge.innerHTML = `<i class="fa-solid fa-circle-check"></i> Selesai`;
      } else {
        statusBadge.className = "text-xs font-semibold px-3 py-1.5 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1.5";
        statusBadge.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Sedang Jalan`;
      }

      document.getElementById('screenDetailIcon').className = `fa-solid ${todo.icon || 'fa-list-check'}`;
      document.getElementById('screenDetailTitle').innerText = todo.title;
      document.getElementById('screenDetailDate').innerText = todo.createdAt;
      document.getElementById('screenDetailDesc').innerText = todo.desc || 'Belum ada deskripsi untuk task ini.';

      const toggleBtn = document.getElementById('screenDetailToggleBtn');
      if (todo.status === 'completed') {
        toggleBtn.className = "w-full py-2.5 text-xs font-semibold rounded-xl bg-amber-500 hover:bg-amber-600 text-white transition flex items-center justify-center gap-2 active:scale-95 shadow-sm";
        toggleBtn.innerHTML = `<i class="fa-solid fa-rotate-left"></i> Tandai Belum Selesai`;
      } else {
        toggleBtn.className = "w-full py-2.5 text-xs font-semibold rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white transition flex items-center justify-center gap-2 active:scale-95 shadow-sm";
        toggleBtn.innerHTML = `<i class="fa-solid fa-circle-check"></i> Tandai Selesai`;
      }
      toggleBtn.onclick = async () => {
        await toggleTodoStatus(todo.id);
        openTodoDetailScreen(todo.id);
      };

      document.getElementById('screenDetailEditBtn').onclick = () => openEditTodoModal(todo.id);
      document.getElementById('screenDetailDeleteBtn').onclick = async () => {
        if (confirm('Apakah kamu yakin ingin menghapus task ini?')) {
          await deleteTodo(todo.id);
          backToDashboard();
        }
      };

      await fetchCommitLogsFromDB(todoId);
    }

    function backToDashboard() {
      state.activeTodoId = null;
      document.getElementById('detailScreenView').classList.add('hidden');
      document.getElementById('dashboardView').classList.remove('hidden');
      renderTodos();
    }

    function renderScreenCommitLogs() {
      const container = document.getElementById('screenDetailTimelineContainer');
      container.innerHTML = '';

      const logs = state.commitLogs.filter(l => l.todoId === state.activeTodoId);
      document.getElementById('screenDetailLogCountBadge').innerText = `${logs.length} Catatan Progress`;

      if (logs.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 bg-slate-50 border border-dashed border-slate-200 rounded-xl p-4">
            <p class="text-xs text-slate-400">Belum ada catatan progress commit untuk tugas ini.</p>
          </div>
        `;
        return;
      }

      logs.forEach((log, idx) => {
        const item = document.createElement('div');
        item.className = "flex gap-3 mb-4 relative";

        item.innerHTML = `
          <div class="flex flex-col items-center">
            <div class="w-7 h-7 bg-lavender-100 text-lavender-600 rounded-full flex items-center justify-center text-xs font-bold shrink-0">
              <i class="fa-solid fa-code-commit"></i>
            </div>
            ${idx < logs.length - 1 ? '<div class="w-0.5 bg-slate-200 flex-1 my-1"></div>' : ''}
          </div>
          <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3.5 flex-1 min-w-0">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[11px] font-bold text-slate-500"><i class="fa-regular fa-clock mr-1"></i>${log.createdAt}</span>
              <button onclick="deleteScreenCommitLog(${log.id})" class="text-slate-400 hover:text-rose-600 text-xs transition">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
            <p class="text-xs md:text-sm text-slate-700 whitespace-pre-line leading-relaxed">${log.message}</p>
          </div>
        `;
        container.appendChild(item);
      });
    }

    async function handleAddScreenCommitLog() {
      const input = document.getElementById('screenDetailCommitMsgInput');
      const text = input.value.trim();
      if (!text || !state.activeTodoId) return;

      const response = await safeFetch(`/api/todos/${state.activeTodoId}/logs`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, user_id: state.currentUser?.id })
      });

      if (!response || !response.ok) {
        const err = response ? await response.json().catch(() => ({})) : {};
        showToast(err.error || 'Gagal menyimpan catatan progress.', 'error');
        return;
      }

      input.value = '';
      await fetchCommitLogsFromDB(state.activeTodoId);
      showToast('Catatan progress ditambahkan.', 'success');
    }

    async function deleteScreenCommitLog(logId) {
      const response = await safeFetch(`/api/commit-logs/${logId}`, { method: 'DELETE' });
      if (!response || !response.ok) {
        showToast('Gagal menghapus catatan log.', 'error');
        return;
      }
      await fetchCommitLogsFromDB(state.activeTodoId);
      showToast('Catatan log dihapus.', 'success');
    }

    // MODAL & FORM HANDLERS FOR FOLDER
    function openAddFolderModal() {
      document.getElementById('folderEditId').value = '';
      document.getElementById('folderNameInput').value = '';
      document.getElementById('folderModalTitle').innerHTML = `<i class="fa-solid fa-folder-plus text-lavender-600"></i> Tambah Folder Baru`;
      renderFolderIconPicker('fa-folder');
      document.getElementById('folderModal').classList.remove('hidden');
    }

    function openEditFolderModal(id) {
      const folder = state.folders.find(f => f.id === id);
      if (!folder) return;

      document.getElementById('folderEditId').value = folder.id;
      document.getElementById('folderNameInput').value = folder.name;
      document.getElementById('folderModalTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-lavender-600"></i> Edit Folder`;
      renderFolderIconPicker(folder.icon || 'fa-folder');
      document.getElementById('folderModal').classList.remove('hidden');
    }

    function closeFolderModal() {
      document.getElementById('folderModal').classList.add('hidden');
    }

    function renderFolderIconPicker(selectedIcon) {
      const container = document.getElementById('iconPickerContainer');
      container.innerHTML = '';
      document.getElementById('selectedFolderIcon').value = selectedIcon;

      ICON_LIST.forEach(icon => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `w-10 h-10 rounded-xl border flex items-center justify-center text-sm transition ${
          icon === selectedIcon ? 'bg-lavender-600 text-white border-lavender-600 shadow' : 'border-slate-200 text-slate-600 hover:bg-slate-100'
        }`;
        btn.innerHTML = `<i class="fa-solid ${icon}"></i>`;
        btn.onclick = () => renderFolderIconPicker(icon);
        container.appendChild(btn);
      });
    }

    async function handleSaveFolder(e) {
      e.preventDefault();
      const id = document.getElementById('folderEditId').value;
      const name = document.getElementById('folderNameInput').value.trim();
      const icon = document.getElementById('selectedFolderIcon').value;
      const userId = state.currentUser?.id;

      if (!userId) { showToast('Sesi tidak valid, silakan masuk ulang.', 'error'); return; }

      let response;
      if (id) {
        response = await safeFetch(`/api/folders/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id: userId, name, icon })
        });
      } else {
        response = await safeFetch('/api/folders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id: userId, name, icon })
        });
      }

      if (!response || !response.ok) {
        const err = response ? await response.json().catch(() => ({})) : {};
        showToast(err.error || 'Gagal menyimpan folder.', 'error');
        return;
      }

      closeFolderModal();
      await fetchFoldersFromDB();
      showToast('Folder berhasil disimpan.', 'success');
    }

    async function deleteFolder(id) {
      if (!confirm('Hapus folder ini? Task yang berada di dalamnya akan otomatis terhapus.')) return;

      const userId = state.currentUser?.id;
      const response = await safeFetch(`/api/folders/${id}?user_id=${userId}`, { method: 'DELETE' });

      if (!response || !response.ok) {
        showToast('Gagal menghapus folder.', 'error');
        return;
      }

      if (state.selectedFolderId === id) state.selectedFolderId = 'all';
      await fetchFoldersFromDB();
      await fetchTodosFromDB();
      showToast('Folder berhasil dihapus.', 'success');
    }

    // MODAL & FORM HANDLERS FOR TODO
    function openAddTodoModal() {
      document.getElementById('todoEditId').value = '';
      document.getElementById('todoTitleInput').value = '';
      document.getElementById('todoDescInput').value = '';
      document.getElementById('todoModalTitle').innerHTML = `<i class="fa-solid fa-square-plus text-lavender-600"></i> Buat Task Baru`;

      populateFolderSelect(state.selectedFolderId !== 'all' ? state.selectedFolderId : null);
      renderTodoIconPicker('fa-list-check');
      document.getElementById('todoModal').classList.remove('hidden');
    }

    function openEditTodoModal(id) {
      const todo = state.todos.find(t => t.id === id);
      if (!todo) return;

      document.getElementById('todoEditId').value = todo.id;
      document.getElementById('todoTitleInput').value = todo.title;
      document.getElementById('todoDescInput').value = todo.desc || '';
      document.getElementById('todoModalTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-lavender-600"></i> Edit Task`;

      populateFolderSelect(todo.folderId);
      renderTodoIconPicker(todo.icon || 'fa-list-check');
      document.getElementById('todoModal').classList.remove('hidden');
    }

    function closeTodoModal() {
      document.getElementById('todoModal').classList.add('hidden');
    }

    function populateFolderSelect(selectedId) {
      const select = document.getElementById('todoFolderSelect');
      select.innerHTML = '';

      state.folders.forEach(f => {
        const opt = document.createElement('option');
        opt.value = f.id;
        opt.innerText = f.name;
        if (f.id == selectedId) opt.selected = true;
        select.appendChild(opt);
      });
    }

    function renderTodoIconPicker(selectedIcon) {
      const container = document.getElementById('todoIconPickerContainer');
      container.innerHTML = '';
      document.getElementById('selectedTodoIcon').value = selectedIcon;

      TASK_ICON_LIST.forEach(icon => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `w-9 h-9 rounded-xl border flex items-center justify-center text-xs transition ${
          icon === selectedIcon ? 'bg-lavender-600 text-white border-lavender-600 shadow' : 'border-slate-200 text-slate-600 hover:bg-slate-100'
        }`;
        btn.innerHTML = `<i class="fa-solid ${icon}"></i>`;
        btn.onclick = () => renderTodoIconPicker(icon);
        container.appendChild(btn);
      });
    }

    async function handleSaveTodo(e) {
      e.preventDefault();
      const id = document.getElementById('todoEditId').value;
      const title = document.getElementById('todoTitleInput').value.trim();
      const rawFolderValue = document.getElementById('todoFolderSelect').value;
      const folderId = rawFolderValue ? parseInt(rawFolderValue) : null;
      const icon = document.getElementById('selectedTodoIcon').value;
      const desc = document.getElementById('todoDescInput').value.trim();
      const userId = state.currentUser?.id;

      if (!userId) { showToast('Sesi tidak valid, silakan masuk ulang.', 'error'); return; }

      let response;
      if (id) {
        response = await safeFetch(`/api/todos/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_id: userId,
            folder_id: folderId,
            title: title,
            description: desc,
            icon: icon
          })
        });
      } else {
        response = await safeFetch('/api/todos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_id: userId,
            folder_id: folderId,
            title: title,
            description: desc,
            icon: icon,
            status: 'pending'
          })
        });
      }

      if (!response || !response.ok) {
        const err = response ? await response.json().catch(() => ({})) : {};
        showToast(err.error || 'Gagal menyimpan task.', 'error');
        return;
      }

      closeTodoModal();
      await fetchTodosFromDB();

      if (state.activeTodoId == id) {
        openTodoDetailScreen(parseInt(id));
      }
      showToast('Task berhasil disimpan.', 'success');
    }

    async function toggleTodoStatus(id) {
      const todo = state.todos.find(t => t.id === id);
      if (!todo) return;

      const newStatus = todo.status === 'completed' ? 'pending' : 'completed';
      const userId = state.currentUser?.id;

      const response = await safeFetch(`/api/todos/${id}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus, user_id: userId })
      });

      if (!response || !response.ok) {
        showToast('Gagal memperbarui status task.', 'error');
        return;
      }

      todo.status = newStatus;
      saveLocalData();
      renderTodos();
    }

    async function deleteTodo(id) {
      const userId = state.currentUser?.id;
      const response = await safeFetch(`/api/todos/${id}?user_id=${userId}`, { method: 'DELETE' });

      if (!response || !response.ok) {
        showToast('Gagal menghapus task.', 'error');
        return;
      }

      state.commitLogs = state.commitLogs.filter(l => l.todoId !== id);
      await fetchTodosFromDB();
      showToast('Task berhasil dihapus.', 'success');
    }

    window.onload = async function() {
      const savedTheme = localStorage.getItem('user_theme') || 'sky';
      switchTheme(savedTheme);

      const activeUser = localStorage.getItem('todo_iandev_active_user');
      if (activeUser) {
        try {
          state.currentUser = JSON.parse(activeUser);
          enterDashboard();
          return;
        } catch (e) {
          localStorage.removeItem('todo_iandev_active_user');
        }
      }

      document.getElementById('loginView').classList.remove('hidden');
      document.getElementById('dashboardView').classList.add('hidden');
    };
  </script>
</body>
</html>